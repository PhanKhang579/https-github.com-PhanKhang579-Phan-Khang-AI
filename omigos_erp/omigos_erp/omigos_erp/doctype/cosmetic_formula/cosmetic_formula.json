{
 "doctype": "DocType",
 "name": "Cosmetic Formula",
 "module": "Omigos ERP",
 "autoname": "field:formula_name",
 "engine": "InnoDB",
 "field_order": [
  "formula_name",
  "product",
  "status",
  "column_break_1",
  "customer",
  "version",
  "batch_size",
  "total_percentage",
  "bom",
  "section_items",
  "items",
  "section_packaging",
  "packaging",
  "section_cost",
  "labor_cost",
  "overhead_cost",
  "column_break_cost",
  "loss_percent"
 ],
 "fields": [
  {
   "fieldname": "formula_name",
   "fieldtype": "Data",
   "label": "Ten cong thuc",
   "reqd": 1,
   "unique": 1
  },
  {
   "fieldname": "product",
   "fieldtype": "Link",
   "options": "Item",
   "label": "San pham"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Trang thai",
   "options": "Draft\nApproved\nObsolete",
   "default": "Draft"
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "customer",
   "fieldtype": "Link",
   "options": "Customer",
   "label": "Khach hang (gia cong)"
  },
  {
   "fieldname": "version",
   "fieldtype": "Data",
   "label": "Phien ban",
   "default": "1.0"
  },
  {
   "fieldname": "batch_size",
   "fieldtype": "Float",
   "label": "Khoi luong me (don vi ton kho cua san pham)",
   "default": "100"
  },
  {
   "fieldname": "total_percentage",
   "fieldtype": "Percent",
   "label": "Tong ty le (%)",
   "read_only": 1
  },
  {
   "fieldname": "bom",
   "fieldtype": "Link",
   "options": "BOM",
   "label": "BOM",
   "read_only": 1
  },
  {
   "fieldname": "section_items",
   "fieldtype": "Section Break",
   "label": "Thanh phan"
  },
  {
   "fieldname": "items",
   "fieldtype": "Table",
   "options": "Cosmetic Formula Item",
   "label": "Thanh phan",
   "reqd": 1
  },
  {
   "fieldname": "section_packaging",
   "fieldtype": "Section Break",
   "label": "Bao bi"
  },
  {
   "fieldname": "packaging",
   "fieldtype": "Table",
   "options": "Cosmetic Formula Packaging",
   "label": "Bao bi / phu kien (tren 1 don vi thanh pham)"
  },
  {
   "fieldname": "section_cost",
   "fieldtype": "Section Break",
   "label": "Chi phi khac (cho moi me)"
  },
  {
   "fieldname": "labor_cost",
   "fieldtype": "Currency",
   "label": "Chi phi nhan cong / me"
  },
  {
   "fieldname": "overhead_cost",
   "fieldtype": "Currency",
   "label": "Chi phi chung (may, dien, khau hao...) / me"
  },
  {
   "fieldname": "column_break_cost",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "loss_percent",
   "fieldtype": "Percent",
   "label": "Hao hut nguyen lieu (%)",
   "description": "Tinh vao gia thanh: chi phi nguyen lieu / (1 - hao hut)"
  }
 ],
 "permissions": [
  {
   "role": "Manufacturing Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  },
  {
   "role": "Manufacturing User",
   "read": 1,
   "write": 1,
   "create": 1
  },
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  }
 ]
}